{
  "name": "findback-campus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && vite build --mode native",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:load": "node tests/load/run-load.mjs",
    "dev:stack": "node tests/stack/dev-stack.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "cap:sync": "npm run build:native && cap sync",
    "build:pages": "npm run build && cp dist/index.html dist/404.html",
    "build:e2e": "VITE_BASE=/findback-campus/ VITE_API_BASE=http://127.0.0.1:8787 npm run build:pages"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-telugu": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autocannon": "^9.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
