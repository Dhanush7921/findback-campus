# Frontend build-time configuration (public values only — never put secrets here).
# Base path for GitHub Pages project sites. Use "/" with a custom domain.
VITE_BASE=/findback-campus/
# Deployed Cloud Run API URL.
VITE_API_BASE=

# Server-side deployment variables.
SHEET_ID=
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
GOOGLE_CLIENT_ID=
STAFF_DOMAIN=
STAFF_EMAILS=admin@college.edu:admin,officer@college.edu:staff,principal@college.edu:management
